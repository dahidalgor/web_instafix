generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum RequestStatus {
  PENDIENTE_UBICACION
  EXPIRADA
  CANCELADA
}
model Customer {
  id String @id @default(uuid())
  name String
  phone String
  phoneVerifiedAt DateTime?
  createdAt DateTime @default(now())
  requests ServiceRequest[]
  @@index([phone])
}
model Offering {
  id String @id
  category String
  device String
  title String
  priceMinor Int
  currency String @default("USD")
  durationMinutes Int
  active Boolean @default(true)
  requests ServiceRequest[]
  appointments Appointment[]
  jobs CompletedJob[]
  description String @default("")
  availability Availability @default(AVAILABLE)
  media Json @default("[]")
  warrantyDays Int @default(0)
  equipmentId String?
  equipment Equipment? @relation(fields: [equipmentId], references: [id])
}
model ServiceRequest {
  id String @id @default(uuid())
  reference String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  offeringId String
  offering Offering @relation(fields: [offeringId], references: [id])
  problem String
  phoneSnapshot String
  priceMinor Int
  currency String
  status RequestStatus @default(PENDIENTE_UBICACION)
  consentAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([status, expiresAt])
}

model HelpRequest {
  id String @id @default(uuid())
  reference String @unique
  name String
  phone String
  device String
  problem String
  status String @default("PENDIENTE_ASESORIA")
  consentAt DateTime
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
  COMING_SOON
}
enum Role {
  CUSTOMER
  ADMIN
}
model Equipment {
  id String @id @default(uuid())
  name String @unique
  category String
  offerings Offering[]
}
model User {
  id String @id @default(uuid())
  firstName String?
  lastName String?
  bookingIntents BookingIntent[]
  name String
  phone String @unique
  email String? @unique
  emailVerifiedAt DateTime?
  passwordHash String
  role Role @default(CUSTOMER)
  phoneVerifiedAt DateTime?
  createdAt DateTime @default(now())
  sessions Session[]
  jobs CompletedJob[]
  appointments Appointment[]
  authTokens AuthToken[]
}
// Desafíos aislados por finalidad. Nunca se guarda el código en texto plano.
model EmailChallenge {
  id String @id @default(uuid())
  email String
  purpose String
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  consumedAt DateTime?
  name String?
  firstName String?
  lastName String?
  phone String?
  passwordHash String?
  userId String?
  @@index([email, purpose, createdAt])
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model CompletedJob {
  id String @id @default(uuid())
  offeringId String?
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  appointmentId String? @unique
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  userId String
  user User @relation(fields: [userId], references: [id])
  title String
  device String
  completedAt DateTime
  warrantyEndsAt DateTime?
  warrantyTerms String
  priceMinor Int
  currency String @default("USD")
  createdAt DateTime @default(now())
  @@index([userId, completedAt])
}
model SitePolicy {
  id String @id @default("warranty")
  text String
  updatedAt DateTime @updatedAt
}

enum AppointmentStatus {
  PENDING_LOCATION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
model Appointment {
  id String @id @default(uuid())
  offeringId String?
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  completedJob CompletedJob?
  userId String?
  user User? @relation(fields: [userId], references: [id])
  contactName String @default("")
  contactPhone String @default("")
  whatsappConsentAt DateTime?
  calUid String? @unique
  calStatus String?
  locationLatitude Float?
  locationLongitude Float?
  locationReceivedAt DateTime?
  locationRequestedAt DateTime @default(now())
  automationIssue String?
  bookingIdentityIssue String?
  automationRevision Int @default(0)
  // INSTAFIX_API: creada por Instafix mediante la API de Cal.com. CAL_EMBED: histórico del iframe.
  source String @default("CAL_EMBED")
  contactEmail String?
  messages AutomationJob[]
  notifications Notification[]
  title String
  device String
  startsAt DateTime
  endsAt DateTime
  timeZone String @default("America/Guayaquil")
  address String
  technician String
  status AppointmentStatus @default(PENDING_LOCATION)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, startsAt])
  @@index([contactPhone, status])
}

// Cola persistente: el reinicio de la API no pierde recordatorios.
model AutomationJob {
  id String @id @default(uuid())
  dedupeKey String @unique
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  revision Int
  kind String
  status String @default("PENDING")
  dueAt DateTime
  expiresAt DateTime
  attempts Int @default(0)
  startedAt DateTime?
  providerId String? @unique
  deliveryStatus String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, dueAt])
}

// No guardamos payloads completos de terceros ni credenciales en el historial.
model IntegrationEvent {
  id String @id
  provider String
  sourceId String
  occurredAt DateTime
  outcome String
  createdAt DateTime @default(now())
  @@index([provider, sourceId, occurredAt])
}

// Una conexión operativa; el estado temporal nunca contiene la Partner Key.
model WhatsAppConnection {
  id String @id @default("main")
  wabaId String?
  connectionMode String?
  connectedAt DateTime?
  stateHash String?
  stateUserId String?
  stateExpiresAt DateTime?
}

// Bandeja durable para responder al webhook antes de ejecutar negocio.
model BridgeWebhook {
  id String @id
  wabaId String
  event String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@index([status, createdAt])
}

model WhatsAppMessage {
  wabaId String
  messageId String
  phone String?
  bsuid String?
  direction String
  source String
  type String
  text String?
  occurredAt DateTime
  content Json
  @@id([wabaId, messageId])
  @@index([wabaId, phone, source, occurredAt])
}

model WhatsAppContact {
  wabaId String
  phone String
  name String?
  removed Boolean @default(false)
  occurredAt DateTime
  @@id([wabaId, phone])
}

// Contexto opaco de reserva: nunca se confía en un userId enviado por Cal.
model BookingIntent {
  tokenHash String @id
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  calUid String? @unique
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model SiteSlide {
  id String @id @default(uuid())
  label String
  title String
  description String
  detail String
  symbol String @default("✦")
  media Json @default("[]")
  position Int @default(0)
  published Boolean @default(false)
  updatedAt DateTime @updatedAt
}
// Métricas propias: sin IP, cookies de seguimiento, teléfono ni correo.
model PageVisit {
  id String @id
  sessionId String
  page String
  activeSeconds Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt, page])
}

// OTP de WhatsApp. Solo se guarda el hash con sal; cada propósito es independiente.
// El registro se conserva aquí hasta verificar el número: la cuenta se crea después.
model PhoneChallenge {
  id String @id @default(uuid())
  purpose String
  phone String
  userId String?
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  delivered Boolean @default(false)
  providerMessageId String?
  firstName String?
  lastName String?
  name String?
  email String?
  passwordHash String?
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
  @@index([userId, createdAt])
}

// Tokens de un solo uso fuera de la sesión: recuperación de contraseña y verificación de correo.
model AuthToken {
  tokenHash String @id
  purpose String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String?
  channel String?
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose, createdAt])
}

// Bandeja durable de avisos de citas por correo. La clave única impide duplicados
// entre la respuesta de la API y los webhooks de Cal.com del mismo hecho.
model Notification {
  id String @id @default(uuid())
  dedupeKey String @unique
  channel String
  kind String
  appointmentId String?
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recipient String
  data Json
  status String @default("PENDING")
  attempts Int @default(0)
  dueAt DateTime @default(now())
  providerMessageId String?
  lastError String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, dueAt])
}

// Historial de envíos: destinatario enmascarado; nunca códigos, tokens ni credenciales.
model CommunicationLog {
  id String @id @default(uuid())
  channel String
  provider String
  kind String
  recipient String
  status String
  providerMessageId String?
  error String?
  appointmentId String?
  userId String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([kind, createdAt])
}
