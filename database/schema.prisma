generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum RequestStatus {
  PENDIENTE_UBICACION
  EXPIRADA
  CANCELADA
}
model Customer {
  id String @id @default(uuid())
  name String
  phone String
  phoneVerifiedAt DateTime?
  createdAt DateTime @default(now())
  requests ServiceRequest[]
  @@index([phone])
}
model Offering {
  id String @id
  category String
  device String
  title String
  priceMinor Int
  currency String @default("USD")
  durationMinutes Int
  active Boolean @default(true)
  requests ServiceRequest[]
  appointments Appointment[]
  jobs CompletedJob[]
  description String @default("")
  availability Availability @default(AVAILABLE)
  media Json @default("[]")
  // Portada independiente de la galería: { url, thumbnail?, alt }. NULL = usar la primera foto.
  cover Json?
  warrantyDays Int @default(0)
  performedServices AppointmentService[]
  equipmentId String?
  equipment Equipment? @relation(fields: [equipmentId], references: [id])
}
model ServiceRequest {
  id String @id @default(uuid())
  reference String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id])
  offeringId String
  offering Offering @relation(fields: [offeringId], references: [id])
  problem String
  phoneSnapshot String
  priceMinor Int
  currency String
  status RequestStatus @default(PENDIENTE_UBICACION)
  consentAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([status, expiresAt])
}

model HelpRequest {
  id String @id @default(uuid())
  reference String @unique
  name String
  phone String
  device String
  problem String
  status String @default("PENDIENTE_ASESORIA")
  consentAt DateTime
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
  COMING_SOON
}
// ADMIN y TECHNICIAN forman el equipo administrativo; comparten la autenticación por sesión.
enum Role {
  CUSTOMER
  ADMIN
  TECHNICIAN
}
// Categoría → equipo → servicio (p. ej. Consolas de Videojuegos → PS5 → Mantenimiento).
model ServiceCategory {
  id String @id @default(uuid())
  name String @unique
  position Int @default(0)
  equipment Equipment[]
}
model Equipment {
  id String @id @default(uuid())
  name String @unique
  categoryId String
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  offerings Offering[]
  @@index([categoryId])
}
model User {
  id String @id @default(uuid())
  firstName String?
  lastName String?
  bookingIntents BookingIntent[]
  name String
  phone String @unique
  email String? @unique
  emailVerifiedAt DateTime?
  passwordHash String
  role Role @default(CUSTOMER)
  // Un miembro del equipo desactivado no puede iniciar sesión; sus sesiones se rechazan.
  active Boolean @default(true)
  phoneVerifiedAt DateTime?
  createdAt DateTime @default(now())
  sessions Session[]
  jobs CompletedJob[]
  appointments Appointment[]
  authTokens AuthToken[]
  assignedAppointments Appointment[] @relation("AssignedTechnician")
  confirmedAppointments Appointment[] @relation("ConfirmedBy")
  completedAppointments Appointment[] @relation("CompletedBy")
  performedServices AppointmentService[]
  appointmentActivity AppointmentActivity[]
}
// Desafíos aislados por finalidad. Nunca se guarda el código en texto plano.
model EmailChallenge {
  id String @id @default(uuid())
  email String
  purpose String
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  consumedAt DateTime?
  name String?
  firstName String?
  lastName String?
  phone String?
  passwordHash String?
  userId String?
  @@index([email, purpose, createdAt])
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model CompletedJob {
  id String @id @default(uuid())
  offeringId String?
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  appointmentId String? @unique
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  userId String
  user User @relation(fields: [userId], references: [id])
  title String
  device String
  completedAt DateTime
  warrantyEndsAt DateTime?
  warrantyTerms String
  priceMinor Int
  currency String @default("USD")
  createdAt DateTime @default(now())
  @@index([userId, completedAt])
}
model SitePolicy {
  id String @id @default("warranty")
  text String
  updatedAt DateTime @updatedAt
}

enum AppointmentStatus {
  PENDING_LOCATION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
model Appointment {
  id String @id @default(uuid())
  offeringId String?
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  completedJob CompletedJob?
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  contactName String @default("")
  contactPhone String @default("")
  whatsappConsentAt DateTime?
  calUid String? @unique
  calStatus String?
  locationLatitude Float?
  locationLongitude Float?
  locationReceivedAt DateTime?
  // Calle y sector calculados a partir de las coordenadas (geocodificación inversa). '' = sin resultado.
  locationArea String?
  locationRequestedAt DateTime @default(now())
  // Origen de la ubicación guardada: WHATSAPP (webhook firmado de Bird), STAFF (pegada por el
  // equipo) o ADMIN. El navegador nunca puede declarar WHATSAPP.
  locationSource String?
  // Nombre o dirección del lugar que envió WhatsApp (distinto de la dirección escrita).
  locationName String?
  // Reprogramaciones reales (cambio de fecha/hora). Máximo 2 por cita, comprobado en backend.
  rescheduleCount Int @default(0)
  // Sesión e IP (con hash) que crearon la cita: presupuesto de WhatsApp y límites por origen.
  originSessionKey String?
  originIpHash String?
  // Eliminación lógica desde administración: la cita deja de mostrarse, el historial se conserva.
  deletedAt DateTime?
  deletedById String?
  automationIssue String?
  bookingIdentityIssue String?
  automationRevision Int @default(0)
  // INSTAFIX_API: creada por Instafix mediante la API de Cal.com. CAL_EMBED: histórico del iframe.
  source String @default("CAL_EMBED")
  contactEmail String?
  messages AutomationJob[]
  notifications Notification[]
  title String
  device String
  startsAt DateTime
  endsAt DateTime
  timeZone String @default("America/Guayaquil")
  address String
  // Nombre visible del técnico (histórico y plantillas). La asignación real es assignedTechnicianId.
  technician String
  assignedTechnicianId String?
  assignedTechnician User? @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  confirmedAt DateTime?
  confirmedById String?
  confirmedBy User? @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  completedAt DateTime?
  completedById String?
  completedBy User? @relation("CompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  // Notas internas del técnico: nunca se muestran al cliente.
  technicianNotes String @default("")
  services AppointmentService[]
  activity AppointmentActivity[]
  status AppointmentStatus @default(PENDING_LOCATION)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, startsAt])
  @@index([contactPhone, status])
  @@index([assignedTechnicianId, startsAt])
  @@index([status, startsAt])
  @@index([originSessionKey, createdAt])
  @@index([originIpHash, createdAt])
  @@index([contactPhone, createdAt])
}

// Trabajo realmente realizado en una visita. Distinto de la solicitud del cliente (Appointment.title).
// Guarda una instantánea de nombre y precio: cambiar el catálogo no altera visitas anteriores.
model AppointmentService {
  id String @id @default(uuid())
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  offeringId String?
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  nameSnapshot String
  deviceSnapshot String
  unitPriceMinor Int
  quantity Int @default(1)
  totalMinor Int
  currency String @default("USD")
  // Preparado para garantías: días anunciados en el catálogo al registrar el trabajo.
  warrantyDaysSnapshot Int @default(0)
  addedById String?
  addedBy User? @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([appointmentId, offeringId])
  @@index([offeringId])
}

// Auditoría de acciones del equipo sobre una cita: quién, qué y cuándo.
model AppointmentActivity {
  id String @id @default(uuid())
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  detail Json @default("{}")
  createdAt DateTime @default(now())
  @@index([appointmentId, createdAt])
}

// Cola persistente: el reinicio de la API no pierde recordatorios.
model AutomationJob {
  id String @id @default(uuid())
  dedupeKey String @unique
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  revision Int
  kind String
  status String @default("PENDING")
  dueAt DateTime
  expiresAt DateTime
  attempts Int @default(0)
  startedAt DateTime?
  // Proveedor que aceptó el envío (BIRD; WASAPFLOW en el historial) y su id del mensaje.
  provider String?
  providerMessageId String? @unique
  // Estado normalizado del webhook: SENT, DELIVERED, READ o FAILED.
  deliveryStatus String?
  // Quién provocó el aviso (sesión/IP con hash). Los avisos del equipo heredan los de la cita.
  originSessionKey String?
  originIpHash String?
  // Teléfono de destino al evaluar el presupuesto (E.164).
  recipient String?
  // Motivo de un aviso no enviado a propósito (SUPPRESSED_*): nunca se reintenta.
  suppressedReason String?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, dueAt])
  @@index([originSessionKey, startedAt])
  @@index([originIpHash, startedAt])
  @@index([recipient, startedAt])
}

// No guardamos payloads completos de terceros ni credenciales en el historial.
model IntegrationEvent {
  id String @id
  provider String
  sourceId String
  occurredAt DateTime
  outcome String
  createdAt DateTime @default(now())
  @@index([provider, sourceId, occurredAt])
}

// Bandeja durable de webhooks de WhatsApp: se responde al proveedor antes de ejecutar negocio.
// id = proveedor + id de entrega (webhook-id en Bird), así un reintento no se procesa dos veces.
model WhatsAppWebhook {
  id String @id
  provider String @default("BIRD")
  accountId String?
  event String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@index([status, createdAt])
}

// Historial de chat (envíos de Instafix, mensajes del cliente, ecos de la app y sincronización).
model WhatsAppMessage {
  provider String @default("BIRD")
  // Número/cuenta del negocio en el proveedor (WABA en el historial de WasapFlow).
  accountId String
  providerMessageId String
  phone String?
  bsuid String?
  direction String
  source String
  type String
  text String?
  occurredAt DateTime
  content Json
  @@id([accountId, providerMessageId])
  @@index([accountId, phone, source, occurredAt])
  @@index([occurredAt])
}

// Contactos sincronizados por WasapFlow (solo historial; Bird no sincroniza la agenda).
model WhatsAppContact {
  accountId String
  phone String
  name String?
  removed Boolean @default(false)
  occurredAt DateTime
  @@id([accountId, phone])
}

// Contexto opaco de reserva: nunca se confía en un userId enviado por Cal.
model BookingIntent {
  tokenHash String @id
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  calUid String? @unique
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model SiteSlide {
  id String @id @default(uuid())
  label String
  title String
  description String
  detail String
  symbol String @default("✦")
  media Json @default("[]")
  position Int @default(0)
  published Boolean @default(false)
  updatedAt DateTime @updatedAt
}
// Métricas propias: sin IP, cookies de seguimiento, teléfono ni correo.
model PageVisit {
  id String @id
  sessionId String
  page String
  activeSeconds Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt, page])
}

// OTP de WhatsApp. Solo se guarda el hash con sal; cada propósito es independiente.
// El registro se conserva aquí hasta verificar el número: la cuenta se crea después.
model PhoneChallenge {
  id String @id @default(uuid())
  purpose String
  phone String
  userId String?
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  delivered Boolean @default(false)
  providerMessageId String?
  firstName String?
  lastName String?
  name String?
  email String?
  passwordHash String?
  // Origen de la solicitud (hash): límites de OTP por IP y por sesión además del teléfono.
  ipHash String?
  sessionKey String?
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@index([sessionKey, createdAt])
}

// Tokens de un solo uso fuera de la sesión: recuperación de contraseña y verificación de correo.
model AuthToken {
  tokenHash String @id
  purpose String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  email String?
  channel String?
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose, createdAt])
}

// Bandeja durable de avisos de citas por correo. La clave única impide duplicados
// entre la respuesta de la API y los webhooks de Cal.com del mismo hecho.
model Notification {
  id String @id @default(uuid())
  dedupeKey String @unique
  channel String
  kind String
  appointmentId String?
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  recipient String
  data Json
  status String @default("PENDING")
  attempts Int @default(0)
  dueAt DateTime @default(now())
  providerMessageId String?
  lastError String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, dueAt])
}

// Historial de envíos: destinatario enmascarado; nunca códigos, tokens ni credenciales.
model CommunicationLog {
  id String @id @default(uuid())
  channel String
  provider String
  kind String
  recipient String
  status String
  providerMessageId String?
  error String?
  appointmentId String?
  userId String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([kind, createdAt])
}


// Números bloqueados por administración (E.164). El motivo es interno: nunca sale al público.
model BlockedPhone {
  phone String @id
  reason String?
  blockedById String?
  createdAt DateTime @default(now())
}

// Contadores de seguridad (p. ej. inicios de sesión fallidos por teléfono o IP con hash).
model RateEvent {
  id String @id @default(uuid())
  scope String
  key String
  createdAt DateTime @default(now())
  @@index([scope, key, createdAt])
}

// Auditoría de acciones administrativas sensibles (eliminar citas, bloquear números…).
model AdminAction {
  id String @id @default(uuid())
  actorId String?
  action String
  target String
  detail Json @default("{}")
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Idempotencia de acciones (doble clic, recarga, reintento) y bloqueo de operaciones en curso.
// key = ámbito + sesión + Idempotency-Key. Se guarda solo la respuesta pública de la acción.
model IdempotencyRecord {
  key String @id
  status String
  response Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
