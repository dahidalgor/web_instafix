PUBLIC_HOST=instafix.ec
ADMIN_HOST=admin.instafix.ec
# Generate a long hexadecimal password; do not commit the actual file.
POSTGRES_PASSWORD=CHANGE_ME
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=instafix-media
R2_PUBLIC_URL=https://media.instafix.ec

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Opcional: buzón real y atendido para respuestas.
SMTP_REPLY_TO=

WASAPFLOW_BASE_URL=https://officialapi.wasapflow.com/bridge/v1
WASAPFLOW_PARTNER_KEY=
# ID de la WABA tal como aparece en WasapFlow. Si se registró en el panel de WasapFlow
# (no con el botón de Administración), Instafix la adopta tras confirmarla en GET /clients.
WASAPFLOW_WABA_ID=
WASAPFLOW_WEBHOOK_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_PHONE=+593984703819
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_INITIAL=instafix_solicitar_ubicacion
WHATSAPP_TEMPLATE_CONFIRMED=instafix_cita_confirmada
WHATSAPP_TEMPLATE_DAY_BEFORE=instafix_recordatorio_manana
WHATSAPP_TEMPLATE_SAME_DAY=instafix_recordatorio_hoy
CAL_WEBHOOK_SECRET=
CAL_API_KEY=
CAL_API_VERSION=2026-02-25
CAL_EVENT_TYPE_ID=

# Verificación de cuentas por WhatsApp (obligatoria). Plantilla AUTHENTICATION aprobada por Meta.
WHATSAPP_OTP_ENABLED=false
WHATSAPP_TEMPLATE_OTP=instafix_codigo_verificacion
# Idioma EXACTO con que Meta aprobó la plantilla OTP (es, es_MX, es_ES…). Si difiere: error Meta 132001.
WHATSAPP_TEMPLATE_OTP_LANGUAGE=es
# Solo desarrollo local (NODE_ENV=development): imprime el OTP en la consola en lugar de enviarlo.
# WHATSAPP_OTP_PROVIDER=console
# Avisos de cita adicionales: sin plantilla aprobada no se envían.
WHATSAPP_TEMPLATE_VISIT_REMINDER=
WHATSAPP_TEMPLATE_RESCHEDULED=
WHATSAPP_TEMPLATE_CANCELLED=
WHATSAPP_TEMPLATE_TECHNICIAN_ASSIGNED=
WHATSAPP_TEMPLATE_TECHNICIAN_ON_THE_WAY=

# Correos de citas enviados por Instafix (Brevo). Activar SOLO después de dejar a Cal.com sin
# correo del cliente (ver docs/communications.md) para no duplicar confirmaciones.
APPOINTMENT_EMAILS_ENABLED=false
# Base de los enlaces de correo (verificación y recuperación).
PUBLIC_WEB_URL=https://instafix.ec
# Buzón propio que Instafix entrega a Cal.com como correo del asistente. Así Cal.com no puede
# escribir al cliente. Debe ser un buzón real de instafix.ec que reciba correo.
CAL_ATTENDEE_RELAY_EMAIL=
CAL_SLOTS_API_VERSION=2024-09-04
