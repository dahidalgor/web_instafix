PUBLIC_HOST=instafix.ec
ADMIN_HOST=admin.instafix.ec
# Generate a long hexadecimal password; do not commit the actual file.
POSTGRES_PASSWORD=CHANGE_ME
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=instafix-media
R2_PUBLIC_URL=https://media.instafix.ec

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Opcional: buzón real y atendido para respuestas.
SMTP_REPLY_TO=

# WhatsApp por Bird (solo el backend; nunca VITE_*). Guía: docs/whatsapp-setup.md
BIRD_API_KEY=
# Secreto de firma del webhook de Bird (whsec_…), se muestra una sola vez al crear el webhook.
BIRD_WEBHOOK_SECRET=
# Número de Instafix conectado en Bird con Coexistence (emisor de los avisos).
WHATSAPP_BUSINESS_PHONE=+593984703819
# Avisos de citas (plantillas appointment_* en Bird).
WHATSAPP_ENABLED=false
# Códigos de verificación de cuentas (plantilla bird_otp de Bird).
WHATSAPP_OTP_ENABLED=false
# Interruptor de emergencia de WhatsApp: false = Bird no recibe ninguna llamada (avisos y OTP).
# Las citas siguen funcionando; los avisos quedan como SUPPRESSED_DISABLED. Por defecto: true.
WHATSAPP_SENDING_ENABLED=true
# Clave para el hash de IPs en los límites (opcional; sin ella se deriva de DATABASE_URL).
# IP_HASH_SECRET=
# Solo desarrollo local (NODE_ENV=development): imprime el OTP en la consola en lugar de enviarlo.
# WHATSAPP_OTP_PROVIDER=console
# Calle y sector de la ubicación del cliente con OpenStreetMap (solo se envían coordenadas).
# REVERSE_GEOCODING_ENABLED=false

CAL_WEBHOOK_SECRET=
CAL_API_KEY=
CAL_API_VERSION=2026-02-25
CAL_EVENT_TYPE_ID=
# Al cambiar de evento en Cal.com: IDs anteriores (separados por comas) para que las citas ya
# agendadas en ellos sigan recibiendo cancelaciones y cambios. Las reservas nuevas usan el actual.
# CAL_PREVIOUS_EVENT_TYPE_IDS=
# Días de antelación por fecha de Ecuador (1 = desde mañana, aunque falten menos de 24 h; 0 = hoy).
# BOOKING_MIN_DAYS_AHEAD=1

# Correos de citas enviados por Instafix (Brevo): «Recibimos tu solicitud», «Tu visita está
# confirmada», reprogramación y cancelación. Activados por defecto; solo «false» los desactiva.
# Cal.com nunca recibe el correo del cliente: la reserva va solo con el teléfono.
APPOINTMENT_EMAILS_ENABLED=
# Base de los enlaces de correo (verificación y recuperación).
PUBLIC_WEB_URL=https://instafix.ec
# Opcional. Las reservas van a Cal.com SOLO con el teléfono (sin correo de asistente). Este buzón
# propio de Instafix solo se usa si Cal.com rechaza una reserva por faltar el correo (se
# reintenta una vez con él y queda el aviso booking.cal_email_required en el registro).
CAL_ATTENDEE_RELAY_EMAIL=
CAL_SLOTS_API_VERSION=2024-09-04

# Notificaciones push del equipo (Web Push). Solo backend, nunca VITE_*. Generar el par con:
#   pnpm --filter @instafix/api push:keys   (o en el servidor: … run --rm api pnpm push:keys)
# Sin estas claves las citas funcionan igual; los avisos esperan. Guía: docs/push-notifications.md
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:avisos@instafix.ec
