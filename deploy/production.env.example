PUBLIC_HOST=instafix.ec
ADMIN_HOST=admin.instafix.ec
# Generate a long hexadecimal password; do not commit the actual file.
POSTGRES_PASSWORD=CHANGE_ME
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=instafix-media
R2_PUBLIC_URL=https://media.instafix.ec

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Opcional: buzón real y atendido para respuestas.
SMTP_REPLY_TO=

WASAPFLOW_BASE_URL=https://officialapi.wasapflow.com/bridge/v1
WASAPFLOW_PARTNER_KEY=
# Opcional: restringe la WABA elegida; la conexión se persiste al completar Embedded Signup.
WASAPFLOW_WABA_ID=
WASAPFLOW_WEBHOOK_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_PHONE=+593984703819
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_INITIAL=instafix_solicitar_ubicacion
WHATSAPP_TEMPLATE_CONFIRMED=instafix_cita_confirmada
WHATSAPP_TEMPLATE_DAY_BEFORE=instafix_recordatorio_manana
WHATSAPP_TEMPLATE_SAME_DAY=instafix_recordatorio_hoy
# Cal.com API v2: motor de disponibilidad y reservas (la web nunca recibe estas claves).
# Sin CAL_API_KEY o CAL_EVENT_TYPE_ID la agenda vuelve al formulario anterior de Cal.com.
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CAL_WEBHOOK_SECRET=
# Opcionales: native (por defecto) o legacy para volver temporalmente al iframe de Cal.com.
# BOOKING_MODE=native
# Campo del evento que recibe la solicitud del cliente («¿Qué trabajo requiere?»).
# CAL_REQUEST_FIELD=notes
# CAL_TIME_ZONE=America/Guayaquil
# Solo pruebas locales: apunta al simulador (pnpm --filter @instafix/api cal:simulator).
# CAL_API_BASE_URL=http://127.0.0.1:3999/v2
