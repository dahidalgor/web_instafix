# IP real del cliente: solo se acepta CF-Connecting-IP cuando la conexión viene de Cloudflare
# (rangos publicados en https://www.cloudflare.com/ips/ — revisarlos de vez en cuando). Desde
# cualquier otro origen, {client_ip} es la IP de la conexión y la cabecera se ignora.
{
  servers {
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    client_ip_headers CF-Connecting-IP
  }
}

{$PUBLIC_HOST}, {$ADMIN_HOST} {
  encode zstd gzip
  header X-Content-Type-Options nosniff
  handle /api/* {
    request_body {
      max_size 101MB
    }
    # La API lee la IP del cliente solo de X-Real-IP, que Caddy siempre sobrescribe.
    reverse_proxy api:3001 {
      header_up X-Real-IP {client_ip}
    }
  }
  # El service worker se revisa siempre (Cloudflare y el navegador no deben servir uno viejo).
  @sw path /sw.js
  header @sw Cache-Control "no-cache"
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
