DATABASE_URL=postgresql://instafix:CHANGE_ME@localhost:5432/instafix
PORT=3001
WEB_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://admin.localhost:5173

# local for development, r2 for production
MEDIA_STORAGE=local
# MEDIA_DIR=/absolute/path/to/persistent/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# SMTP: requiere proveedor y remitente de instafix.ec verificado (docs/site-experience.md).
# 465 utiliza TLS directo; 587 exige STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Opcional: buzón atendido para respuestas; no inventar una dirección inexistente.
SMTP_REPLY_TO=

# WhatsApp por Bird (solo el backend; nunca VITE_*). Guía: docs/whatsapp-setup.md
BIRD_API_KEY=
# Secreto de firma del webhook de Bird (whsec_…), se muestra una sola vez al crear el webhook.
BIRD_WEBHOOK_SECRET=
# Número de Instafix conectado en Bird con Coexistence (emisor de los avisos).
WHATSAPP_BUSINESS_PHONE=+593984703819
# Avisos de citas (plantillas appointment_* en Bird).
WHATSAPP_ENABLED=false
# Códigos de verificación de cuentas (plantilla bird_otp de Bird).
WHATSAPP_OTP_ENABLED=false
# Interruptor de emergencia de WhatsApp: false = Bird no recibe ninguna llamada (avisos y OTP).
# Las citas siguen funcionando; los avisos quedan como SUPPRESSED_DISABLED. Por defecto: true.
WHATSAPP_SENDING_ENABLED=true
# Clave para el hash de IPs en los límites (opcional; sin ella se deriva de DATABASE_URL).
# IP_HASH_SECRET=
# Solo desarrollo local (NODE_ENV=development): imprime el OTP en la consola en lugar de enviarlo.
# WHATSAPP_OTP_PROVIDER=console
# Calle y sector de la ubicación del cliente con OpenStreetMap (solo se envían coordenadas).
# REVERSE_GEOCODING_ENABLED=false

CAL_WEBHOOK_SECRET=
CAL_API_KEY=
CAL_API_VERSION=2026-02-25
CAL_EVENT_TYPE_ID=
# Días de antelación por fecha de Ecuador (1 = desde mañana, aunque falten menos de 24 h; 0 = hoy).
# BOOKING_MIN_DAYS_AHEAD=1

# Correos de citas enviados por Instafix (Brevo): «Recibimos tu solicitud», «Tu visita está
# confirmada», reprogramación y cancelación. Activados por defecto; solo «false» los desactiva.
# Cal.com nunca recibe el correo del cliente (CAL_ATTENDEE_RELAY_EMAIL o el remitente SMTP_FROM).
APPOINTMENT_EMAILS_ENABLED=
# Base de los enlaces de correo (verificación y recuperación).
PUBLIC_WEB_URL=http://localhost:5173
# Buzón propio que Instafix entrega a Cal.com como correo del asistente. Así Cal.com no puede
# escribir al cliente. Debe ser un buzón real de instafix.ec que reciba correo.
CAL_ATTENDEE_RELAY_EMAIL=
CAL_SLOTS_API_VERSION=2024-09-04
