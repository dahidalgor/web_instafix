DATABASE_URL=postgresql://instafix:CHANGE_ME@localhost:5432/instafix
PORT=3001
WEB_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://admin.localhost:5173

# local for development, r2 for production
MEDIA_STORAGE=local
# MEDIA_DIR=/absolute/path/to/persistent/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# SMTP: requiere proveedor y remitente de instafix.ec verificado (docs/site-experience.md).
# 465 utiliza TLS directo; 587 exige STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Opcional: buzón atendido para respuestas; no inventar una dirección inexistente.
SMTP_REPLY_TO=

# WasapFlow Bridge + Coexistence. Mantener envíos desactivados hasta conectar.
WASAPFLOW_BASE_URL=https://officialapi.wasapflow.com/bridge/v1
WASAPFLOW_PARTNER_KEY=
# Opcional: restringe la WABA elegida; la conexión se persiste al completar Embedded Signup.
WASAPFLOW_WABA_ID=
WASAPFLOW_WEBHOOK_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_BUSINESS_PHONE=+593984703819
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_INITIAL=instafix_solicitar_ubicacion
WHATSAPP_TEMPLATE_CONFIRMED=instafix_cita_confirmada
WHATSAPP_TEMPLATE_DAY_BEFORE=instafix_recordatorio_manana
WHATSAPP_TEMPLATE_SAME_DAY=instafix_recordatorio_hoy
CAL_WEBHOOK_SECRET=
CAL_API_KEY=
CAL_API_VERSION=2026-02-25
CAL_EVENT_TYPE_ID=
